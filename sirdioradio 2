<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SIRDIO 100.20 FM - Live From Kumasi</title>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Outfit',sans-serif;background:#0a0a0f;color:white;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
.card{width:100%;max-width:420px;background:#15151f;border-radius:32px;padding:28px;border:1px solid #2a2a3a;box-shadow:0 20px 60px rgba(0,0,0,0.5)}
.header{display:flex;justify-content:space-between;align-items:center}
.logo{width:48px;height:48px;background:linear-gradient(135deg,#ff6a00,#ff2e00);border-radius:14px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:20px}
.live{display:flex;align-items:center;gap:8px;background:#1f1f2e;border:1px solid #ff3b30;padding:8px 14px;border-radius:100px;font-size:12px;font-weight:700}
.dot{width:8px;height:8px;background:#ff3b30;border-radius:50%;animation:blink 1s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0.3}}
.title{text-align:center;margin:22px 0}
.title h1{font-size:34px;font-weight:800;letter-spacing:-1px}
.title h1 span{color:#ff6a00}
.title p{color:#8a8aa0;margin-top:6px;font-size:13px}
.art{width:100%;aspect-ratio:1;background:#1f1f2e;border-radius:24px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #2a2a3a;margin:20px 0}
.eq{display:flex;gap:5px;align-items:end;height:40px;margin-bottom:16px}
.bar{width:6px;background:#ff6a00;border-radius:10px;animation:wave 0.8s infinite ease-in-out}
.bar:nth-child(2){animation-delay:0.1s;height:24px}.bar:nth-child(3){animation-delay:0.2s;height:32px}.bar:nth-child(4){animation-delay:0.3s;height:18px}.bar:nth-child(5){animation-delay:0.15s;height:28px}
@keyframes wave{0%,100%{height:12px}50%{height:36px}}
.paused .bar{animation-play-state:paused}
.play{width:80px;height:80px;background:linear-gradient(135deg,#ff6a00,#ff2e00);border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 10px 30px rgba(255,106,0,0.4);margin:0 auto 20px}
.stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin:20px 0}
.stat{background:#1f1f2e;border-radius:16px;padding:12px;text-align:center;border:1px solid #2a2a3a}
.stat b{display:block;font-size:16px;font-weight:800}.stat span{font-size:10px;color:#8a8aa0}
.btns{display:flex;gap:10px}
.btn{flex:1;padding:14px;border-radius:14px;border:none;font-weight:700;font-size:13px;cursor:pointer}
.btn-dark{background:#1f1f2e;color:white;border:1px solid #2a2a3a}.btn-orange{background:linear-gradient(135deg,#ff6a00,#ff2e00);color:white}
</style>
</head>
<body>
<div class="card">
<div class="header"><div class="logo">S</div><div class="live"><div class="dot"></div>LIVE ON AIR</div></div>
<div class="title"><h1>SIRDIO <span>100.20</span> FM</h1><p>Kumasi Rd, Ghana • Mobile Network Live</p></div>
<div class="art paused" id="art"><div class="eq"><div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div></div><div style="font-size:11px;color:#8a8aa0;letter-spacing:2px;font-weight:700">NOW PLAYING</div><div style="font-weight:700;margin-top:4px">Live Broadcast</div></div>
<button class="play" onclick="togglePlay()"><svg id="playI" width="32" height="32" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg><svg id="pauseI" style="display:none" width="32" height="32" viewBox="0 0 24 24" fill="white"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg></button>
<div class="stats"><div class="stat"><b>100.20</b><span>FM FREQ</span></div><div class="stat"><b id="lis">1,247</b><span>LISTENING</span></div><div class="stat"><b>HD</b><span>QUALITY</span></div></div>
<audio id="audio"></audio>
<div class="btns"><button class="btn btn-dark" onclick="navigator.share?navigator.share({title:'SIRDIO 100.20 FM',url:location.href}):prompt('Copy link:',location.href)">SHARE 📤</button><button class="btn btn-orange" onclick="window.open('https://wa.me/233000000000?text=Listening to Sirdio 100.20 FM')">WHATSAPP</button></div>
<p style="text-align:center;color:#5a5a72;font-size:11px;margin-top:18px">Powered by MTN 4G • SIRDIO LIVE</p>
</div>
<script>
const STREAM_URL="https://stream.zeno.fm/5f5n8z7v3rquv";
const audio=document.getElementById('audio'),art=document.getElementById('art'),playI=document.getElementById('playI'),pauseI=document.getElementById('pauseI');
let playing=false;
function togglePlay(){
if(!playing){audio.src=STREAM_URL;audio.play().then(()=>{playing=true;art.className='art';playI.style.display='none';pauseI.style.display='block';}).catch(()=>alert('Replace STREAM_URL with your real Zeno link!'));}
else{audio.pause();playing=false;art.className='art paused';playI.style.display='block';pauseI.style.display='none';}
}
setInterval(()=>document.getElementById('lis').innerText=Math.floor(1200+Math.random()*200).toLocaleString(),3000);
</script>
</body>
</html>
