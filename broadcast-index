<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>STUDIO</title><script src="https://unpkg.com/peerjs@1.5.3/dist/peerjs.min.js"></script><style>body{margin:0;background:#000;color:#fff;text-align:center;padding:20px;font-family:Arial}.card{background:#161616;border-radius:20px;padding:25px;max-width:500px;margin:auto;border:2px solid red}.btn{padding:20px;width:100%;border-radius:50px;border:0;font-weight:900;font-size:18px;margin:10px 0}.start{background:red;color:#fff}.stop{background:#333;color:#fff}</style></head><body><div class="card"><h1>🎙️ SIR FLAVE STUDIO</h1><div id="st" style="background:#222;padding:10px;border-radius:10px">Connecting...</div><div style="font-size:60px;margin:20px" id="mi">🎤</div><button id="g" class="btn start" onclick="goLive()">🔴 START LIVE</button><button id="s2" class="btn stop" style="display:none" onclick="location.reload()">⏹️ STOP</button><p>Listeners: <b id="co">0</b></p></div><script>let peer,ls,cons=[];function init(){peer=new Peer('SIRDIO-PLAY-LIVE',{config:{iceServers:[{urls:'stun:stun.l.google.com:19302'}]}});peer.on('open',()=>{document.getElementById('st').innerHTML='✅ READY - Tap START LIVE';});peer.on('call',c=>{if(ls){c.answer(ls);cons.push(c);document.getElementById('co').innerText=cons.length}})}async function goLive(){ls=await navigator.mediaDevices.getUserMedia({audio:true});document.getElementById('st').innerHTML='🔴 LIVE ON AIR!';document.getElementById('g').style.display='none';document.getElementById('s2').style.display='block';document.getElementById('mi').innerText='🔴🎤'}init();</script></body></html>
